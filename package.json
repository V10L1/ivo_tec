{
  "name": "modular-admin-platform",
  "version": "1.0.0",
  "description": "Uma plataforma de administração modular full-stack com frontend React e backend Node.js.",
  "main": "dist/server/server.js",
  "scripts": {
    "build:backend": "tsc --project tsconfig.backend.json",
    "build:frontend": "esbuild index.tsx --bundle --outfile=dist/client/index.js --jsx=automatic --format=esm --external:react --external:react-dom/* --external:react/jsx-runtime",
    "build": "npm run build:backend && npm run build:frontend",
    "dev:server": "ts-node-dev --respawn --transpile-only server.ts",
    "start": "node dist/server/server.js",
    "deploy": "npm run build && pm2 reload ecosystem.config.js --update-env"
  },
  "keywords": [
    "react",
    "nodejs",
    "express",
    "postgresql",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^0.15.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.21.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}